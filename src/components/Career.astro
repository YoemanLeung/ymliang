---
import data from '../data/academic.json';
import {localUrl} from '../lib/publications.mjs';
import ProgramSupport from './ProgramSupport.astro';
import ProfessionalService from './ProfessionalService.astro';
---
<section class="content-section" id="cv" aria-labelledby="cv-heading">
  <div class="section-heading"><span class="eyebrow">05 / CURRICULUM VITAE</span><h2 id="cv-heading">A path through astronomy</h2></div>
  <div class="cv-actions"><a class="button primary" href={localUrl('cv/')}>Read my CV</a><a class="button" href={localUrl('files/yongming-liang-cv.pdf')} download>Download CV <span class="filetype">PDF</span></a></div>
  <div class="career-grid">
    <div><h3>Appointments</h3>
      <dl class="timeline">{data.profile.appointments.map(job=><div><dt>{job.start} — {job.end || 'present'}</dt><dd><strong>{job.role}</strong><span>{job.institution}</span></dd></div>)}</dl>
    </div>
    <div><h3>Education</h3>
      <dl class="timeline"><div><dt>2017 — 2022</dt><dd><strong>Ph.D. · Astronomy</strong><span>SOKENDAI / NAOJ</span></dd></div><div><dt>2013 — 2017</dt><dd><strong>Bachelor's degree · Astronomy</strong><span>University of Science and Technology of China</span></dd></div></dl>
    </div>
  </div>
  <h3 class="funding-heading">Research funding</h3>
  <p class="funding-line"><a href="https://kaken.nii.ac.jp/en/grant/KAKENHI-PROJECT-24K17084/">JSPS KAKENHI 24K17084</a> · Principal Investigator · Early-Career Scientists · 2024–2027</p>
  <p class="funding-line"><a href="https://kaken.nii.ac.jp/en/grant/KAKENHI-PROJECT-25H00663/">JSPS KAKENHI 25H00663</a> · Co-Investigator · Scientific Research (A) · 2025–2030</p>
  <ProgramSupport />
  <h3 class="funding-heading">Professional service & membership</h3>
  <ProfessionalService />
</section>
