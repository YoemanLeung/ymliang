---
import {summaryTimeLabel} from '../lib/proposals.mjs';
const {cell} = Astro.props;
---
{cell.measurements.map(time => <span class="observing-value">
  <strong>{summaryTimeLabel(time)}</strong>
</span>)}
{!cell.measurements.length && cell.unquantified > 0 && <span class="observing-value"><strong>{cell.unquantified} {cell.unquantified === 1 ? 'program' : 'programs'}</strong></span>}
{cell.analysis > 0 && <span class="observing-value"><strong>{cell.analysis} Analysis {cell.analysis === 1 ? 'program' : 'programs'}</strong></span>}
{!cell.measurements.length && !cell.unquantified && !cell.analysis && <span class="observing-empty" aria-label="No recorded allocation">—</span>}
