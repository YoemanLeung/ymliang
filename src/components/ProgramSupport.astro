---
import {support} from '../data/observing-summary.json';
const amount = 'US$'+support.amount.toLocaleString('en-US');
---
<p class="program-support" id="chandra-support"><strong><a href={support.url}>Chandra {support.cycle}</a> · Science PI · Associated U.S. observing grant</strong><br />{amount} approved for U.S. investigators. U.S. administrative PI: {support.administrativePi} ({support.administrativePiAffiliation}).</p>
