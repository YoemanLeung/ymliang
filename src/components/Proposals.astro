---
import summary from '../data/observing-summary.json';
import ObservingCell from './ObservingCell.astro';
const {document = false} = Astro.props;
---
<section class="content-section proposals-section" id="proposals" aria-labelledby="proposals-heading">
  <div class="section-heading">{!document && <span class="eyebrow">04 / PROPOSALS</span>}<h2 id="proposals-heading">Observing time</h2></div>
  <p class="proposal-guide">Telescope time for PI-led projects and collaborations · {summary.period.start}–{summary.period.end}</p>
  <div class="observing-table-wrap">
    <table class="observing-table" aria-describedby="observing-notes">
      <caption class="sr-only">Recorded telescope time by facility and role</caption>
      <thead><tr><th scope="col">Telescope</th><th scope="col">PI</th><th scope="col">Co-I / collaborator</th></tr></thead>
      <tbody>{summary.facilities.map(row => <tr data-facility={row.id}>
        <th scope="row">{row.facility}</th>
        <td><ObservingCell cell={row.pi} /></td>
        <td><ObservingCell cell={row.collaboration} /></td>
      </tr>)}</tbody>
    </table>
  </div>
  <p class="observing-notes" id="observing-notes">Recorded semester allocations, including repeat awards; not completed observing time. Grade C requests and observed time are labeled. Unquantified allocations are excluded from totals.</p>
</section>
