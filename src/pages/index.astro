---
import Base from '../layouts/Base.astro';
import Identity from '../components/Identity.astro';
import Research from '../components/Research.astro';
import Publications from '../components/PublicationBrowser.astro';
import Career from '../components/Career.astro';
import Talks from '../components/Talks.astro';
import Proposals from '../components/Proposals.astro';
import News from '../components/News.astro';
import SpaceScene from '../components/SpaceScene.astro';
import {localUrl} from '../lib/publications.mjs';
---
<Base mode="space" title="Yongming Liang | Across the cosmic web">
  <main id="main">
    <section class="space-hero" aria-labelledby="space-title">
      <SpaceScene />
      <div class="space-hero-layout">
      <div class="space-hero-copy">
        <p class="eyebrow">EXTRAGALACTIC ASTRONOMY</p>
        <h1 id="space-title">Across the<br /><em>cosmic web.</em></h1>
        <p class="space-subtitle">Galaxies. Black holes. Intergalactic gas.<br />Exploring the connections that shape our Universe.</p>
        <div class="space-hero-actions"><a class="button primary" href="#research">Discover the research</a><a class="button" href="#publications">Publications</a></div>
      </div>
      <div class="hero-profile"><Identity compact portrait={{src: 'images/yongming-liang-alps.jpg', width: 886, height: 886}} /></div>
      </div>
      <a class="scroll-cue" href="#about"><span>More about me</span><span aria-hidden="true">↓</span></a>
    </section>
    <div class="space-content">
      <section class="space-about" id="about">
        <div><p class="eyebrow">ABOUT ME</p><h2>Reading the Universe<br />through its connections.</h2></div>
        <div><p>I study how galaxies and supermassive black holes evolve within the cosmic web, and how they interact with the gas around and between galaxies.</p><p>At ICRR, The University of Tokyo, I combine wide-field imaging, spectroscopy, and multiwavelength observations to explore these relationships in the distant Universe. I received my Ph.D. from SOKENDAI in 2022, working at NAOJ.</p><a href={localUrl('cv/')}>Curriculum vitae <span aria-hidden="true">↗</span></a></div>
      </section>
      <Research />
      <Career />
      <Publications />
      <Talks />
      <Proposals />
      <News />
    </div>
  </main>
</Base>
