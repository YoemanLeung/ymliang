---
import {localUrl} from '../lib/publications.mjs';
const destination = localUrl()+'#proposals';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={'0;url='+destination} />
    <title>Observing time | Yongming Liang</title>
    <script is:inline define:vars={{destination}}>window.location.replace(destination);</script>
  </head>
  <body><a href={destination}>Continue to the observing-time summary</a></body>
</html>
